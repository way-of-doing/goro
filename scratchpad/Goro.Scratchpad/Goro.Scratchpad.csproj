<Project Sdk="Microsoft.NET.Sdk">

  <!-- A warehouse for experiments worth keeping: not part of Goro.slnx, not production code. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The version src/Goro uses, so that probes ask questions of the library Goro actually ships. -->
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Candidates weighed by FileReading/ against the audio fixture corpus. None is used by src/. -->
    <PackageReference Include="Concentus.Oggfile" Version="1.0.7" />
    <PackageReference Include="NLayer" Version="3.0.0" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="TagLibSharp2" Version="0.6.0" />
    <PackageReference Include="z440.atl.core" Version="7.18.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- So that experiments can measure Goro's own code beside the candidates it was chosen from. -->
    <ProjectReference Include="..\..\src\Goro\Goro.csproj" />
  </ItemGroup>

</Project>
