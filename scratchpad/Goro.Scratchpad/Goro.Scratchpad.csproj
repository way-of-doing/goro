<Project Sdk="Microsoft.NET.Sdk">

  <!-- A warehouse for experiments worth keeping: not part of Goro.slnx, not production code. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The version src/Goro uses, so that probes ask questions of the library Goro actually ships. -->
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- So that experiments can measure Goro's own code beside the candidates it was chosen from. -->
    <ProjectReference Include="..\..\src\Goro\Goro.csproj" />
  </ItemGroup>

</Project>
